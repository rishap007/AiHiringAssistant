# Frontend API base URL; use http://localhost:8000 for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Get from the Hunar dashboard or project owner.
HUNAR_API_KEY=your-hunar-api-key
# Hunar API documentation: https://api.voice.hunar.ai/external/v1
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1
# Local Docker Compose database URL; update for hosted Postgres.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hunar
# Public URL where Hunar can deliver webhooks (use a tunnel locally).
WEBHOOK_BASE_URL=http://localhost:8000
# Get from your selected LLM provider dashboard.
LLM_API_KEY=your-llm-api-key
# Set to the model identifier supported by your LLM provider.
LLM_MODEL=your-llm-model
# Use mock locally, or set the supported production provider.
PEOPLE_SEARCH_PROVIDER=mock
# Optional: get from the configured people-search provider.
PEOPLE_SEARCH_API_KEY=
